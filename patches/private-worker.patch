+/* Personal deployment based on annpardo/CF-Workers-TGProxy (GPL-3.0).
+   Changes: require access key for dashboard/statistics; remove third-party contact links and misleading labels. */
+function privateAccess(url, secret) {
+  const given = url.searchParams.get('access') || '';
+  if (given.length !== secret.length) return false;
+  let diff = 0;
+  for (let i = 0; i < secret.length; i++) diff |= given.charCodeAt(i) ^ secret.charCodeAt(i);
+  return diff === 0;
+}
