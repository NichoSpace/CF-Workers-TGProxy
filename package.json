{
  "name": "maple-notes-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "check:bundle": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run verify && wrangler deploy",
    "sync:upstream": "node scripts/sync-upstream.mjs"
  },
  "devDependencies": { "wrangler": "4.151.0" }
}
